        PROXY_STATIC_LIST = list(_file_proxies)
        print(f"[PROXY] SKIP proxy awal aktif — hanya {len(_file_proxies)} proxy hasil finder dipakai")
    else:
        PROXY_STATIC_LIST = list(dict.fromkeys(PROXY_STATIC_LIST + _file_proxies))
        print(f"[PROXY] {len(_file_proxies)} proxy dari {PROXY_FILE} ditambahkan ke fallback list")

