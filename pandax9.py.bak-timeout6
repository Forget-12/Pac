# Proxy hasil proxy_finder.py — dimuat sebagai fallback saat file ada.
# Toggle "skip proxy awal" utk percobaan: env PANDAX_SKIP_INITIAL_PROXY=1
# ATAU buat file penanda `.skip_session_proxy` (paling tahan lintas proot):
#   touch .skip_session_proxy   → session template dimatikan, pakai list static+found
#   rm .skip_session_proxy      → kembali normal (sticky session)
PROXY_FILE     = "proxies_found.txt"
PROXY_FILE_MAX = 100
SKIP_SESSION_PROXY = (os.environ.get("PANDAX_SKIP_INITIAL_PROXY") == "1"
                      or os.path.exists(".skip_session_proxy"))


def _load_proxy_file(path, limit):
    out, seen = [], set()
    try:
        with open(path, encoding="utf-8") as pf:
            for line in pf:
                p = line.strip()
                if not p or p.startswith("#"):
                    continue
                if not re.match(r"^(https?|socks5h?)://\S+$", p):
                    continue
                if p in seen:
                    continue
                seen.add(p)
                out.append(p)
                if len(out) >= limit:
                    break
    except FileNotFoundError:
        pass
    except Exception as e:
        print(f"[PROXY] Gagal baca {path}: {e}")
    return out


_file_proxies = _load_proxy_file(PROXY_FILE, PROXY_FILE_MAX)
