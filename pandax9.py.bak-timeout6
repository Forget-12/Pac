_LOG_STYLE = {
    "SUCCESS": ("✓",  Fore.GREEN + Style.BRIGHT,        Fore.GREEN + Style.BRIGHT),
    "ERROR":   ("✗",  Fore.RED + Style.BRIGHT,          Fore.RED + Style.BRIGHT),
    "FATAL":   ("✗",  Fore.RED + Style.BRIGHT,          Fore.RED + Style.BRIGHT),
    "WAIT":    ("⏳", Fore.YELLOW,                     Fore.YELLOW),
    "PROXY":   ("⇆",  Fore.MAGENTA,                    Fore.MAGENTA),
    "PROXYOK": ("✓",  Fore.GREEN,                      Fore.GREEN),
    "SKIP":    ("⊘",  Fore.LIGHTBLACK_EX,              Fore.LIGHTBLACK_EX),
    "SOLVER":  ("✦",  Fore.LIGHTCYAN_EX,               Fore.LIGHTCYAN_EX),
    "POLL":    ("↺",  Fore.CYAN,                       Fore.CYAN),
    "STEP":    ("→",  Fore.LIGHTGREEN_EX,              Fore.WHITE + Style.BRIGHT),
    "TIMING":  ("◷",  Fore.LIGHTYELLOW_EX,             Fore.LIGHTYELLOW_EX),
    "RETRY":   ("↻",  Fore.YELLOW + Style.BRIGHT,      Fore.YELLOW + Style.BRIGHT),
    "NET":     ("⇄",  Fore.LIGHTBLUE_EX,               Fore.LIGHTBLUE_EX),
    "COIN":    ("◈",  Fore.LIGHTMAGENTA_EX,            Fore.LIGHTMAGENTA_EX),
    "BLOCKED": ("⊘",  Fore.LIGHTBLACK_EX,              Fore.LIGHTBLACK_EX),
    "CRASH":   ("✗",  Fore.RED + Style.BRIGHT,         Fore.RED + Style.BRIGHT),
}

def log(worker_id, email, status, msg):
    ts = datetime.now().strftime("%H:%M:%S")
    short_email = (email[:12] + "…") if email else "system"
    w_id = f"W{worker_id}" if worker_id else "SYS"
    icon, tag_color, msg_color = _LOG_STYLE.get(status, ("•", Fore.WHITE, Fore.WHITE))
    dim = Style.DIM + Fore.LIGHTBLACK_EX
    print(f"{dim}{ts}{Style.RESET_ALL} {tag_color}{icon} {status:<7}{Style.RESET_ALL} "
          f"{Fore.BLUE + Style.BRIGHT}{w_id:<3}{Style.RESET_ALL} "
          f"{dim}{short_email:<14}{Style.RESET_ALL}"
          f" {dim}│{Style.RESET_ALL} {msg_color}{msg}{Style.RESET_ALL}",
          flush=True)


# =====================================================================
# DYNAMIC COIN REWARD SCRAPER — sort by nilai USD reward
# =====================================================================
async def fetch_and_sort_coins():
    global SORTED_COINS
    log(None, None, "BOT", "Menganalisis halaman /faucet-coins & harga pasar crypto...")

    try:
        r = None
        for attempt in (1, 2):
            try:
                async with AsyncSession(impersonate="chrome110", verify=False,
                                        timeout=20.0) as sess:
                    r = await sess.get(f"{BASE_URL}/faucet-coins")
                break
            except Exception as e:
                log(None, None, "WAIT",
                    f"Analisa faucet-coins gagal (percobaan {attempt}/2): {str(e)[:60]}")
                if attempt == 1:
                    await asyncio.sleep(3)
        if r is None:
            raise Exception("faucet-coins tidak bisa dijangkau (2x percobaan gagal)")

        html = r.text
        coin_raw_rewards = {}

        # Strategi 1: href="claim-xxx" ... <span class="gv">nilai</span>
        pattern = r'href="claim-([a-z]+)"[^>]*>.*?<span class="gv">([0-9.]+)'
        for coin, val_str in re.findall(pattern, html, re.DOTALL):
            if coin in AVAILABLE_COINS:
                try:
                    val = float(val_str)
                    if coin not in coin_raw_rewards or val > coin_raw_rewards[coin]:
                        coin_raw_rewards[coin] = val
                except ValueError:
                    pass

        # Strategi 2 (fallback): "<angka> <COIN>"
        if not coin_raw_rewards:
            coins_pattern = "|".join(c.upper() for c in AVAILABLE_COINS)
            pattern2 = r'([0-9]+\.[0-9]+)[^A-Za-z0-9]*(' + coins_pattern + r')\b'
            for val_str, coin_str in re.findall(pattern2, html):
                coin = coin_str.lower()
                try:
                    val = float(val_str)
                    if coin not in coin_raw_rewards or val > coin_raw_rewards[coin]:
                        coin_raw_rewards[coin] = val
                except ValueError:
                    pass

        if not coin_raw_rewards:
            raise Exception("Gagal mendeteksi angka reward")

        # Harga USD dari CoinGecko (tanpa proxy — API publik)
        cg_ids = ",".join(COINGECKO_IDS[c] for c in coin_raw_rewards if c in COINGECKO_IDS)
        prices = {}
        try:
            async with AsyncSession(impersonate="chrome110", verify=False,
                                    timeout=10.0) as cg:
                cg_url = (f"https://api.coingecko.com/api/v3/simple/price"
                          f"?ids={cg_ids}&vs_currencies=usd")
                resp = await cg.get(cg_url)
                if resp.status_code == 200:
                    prices = resp.json()
        except Exception as e:
            log(None, None, "ERROR", f"Gagal ambil harga CoinGecko: {str(e)[:40]}")

        coin_usd_values = {}
        for coin, raw_val in coin_raw_rewards.items():
            cg_id = COINGECKO_IDS.get(coin)
            usd_price = prices.get(cg_id, {}).get("usd", 0) if cg_id else 0
            if not prices:
                usd_price = 1.0   # CoinGecko gagal → pakai raw reward sebagai proxy
            coin_usd_values[coin] = raw_val * usd_price

        SORTED_COINS = sorted(coin_usd_values, key=lambda k: coin_usd_values[k],
                              reverse=True)
        log_str = ", ".join(f"{c.upper()}(${coin_usd_values[c]:.6f})" for c in SORTED_COINS)
        log(None, None, "COIN", f"Urutan Coin (USD): {log_str}")

    except Exception as e:
        log(None, None, "ERROR", f"Gagal total proses analisa: {str(e)[:50]}")
        if SORTED_COINS:
            log(None, None, "COIN",
                f"Pertahankan urutan sebelumnya "
                f"({', '.join(c.upper() for c in SORTED_COINS)}) — harga tidak terbaca, bukan bug fatal")
        else:
            log(None, None, "COIN", "Menggunakan urutan default.")
            SORTED_COINS = list(AVAILABLE_COINS)


# =====================================================================
# PROXY HELPERS (identik)
# =====================================================================
def _proxy_label(proxy_url):
    try:
        cred = proxy_url.split("://", 1)[1].split("@", 1)[0]
        user = cred.split(":", 1)[0]
        m = re.search(r"-sess-([a-z0-9]+)", user)
        if m:
            return f"sess-{m.group(1)[-6:]}"
        return user[-8:] if len(user) > 8 else user
    except Exception:
        return "proxy"


def _is_proxy_error(e):
    m = str(e).lower()
    return any(x in m for x in [
        "connect tunnel", "connect failed", "connection refused",
        "failed to perform", "couldn't connect", "could not resolve",
        "network is unreachable", "connection reset", "timed out",
        "curl: (5)", "curl: (6)", "curl: (7)", "curl: (28)",
        "curl: (35)", "curl: (52)", "curl: (56)",
    ])


def block_proxy(proxy_url):
    global _global_proxy_fails
    _vpn_blocked[proxy_url] = time.time() + VPN_BLOCK_COOLDOWN
    _global_proxy_fails += 1


def _random_sid():
    return "".join(random.choices(string.ascii_lowercase + string.digits, k=SESSION_SID_LEN))


_finder_lock = asyncio.Lock()
_last_finder_run = 0.0
FINDER_MIN_INTERVAL = 300     # detik — maks 1x auto-refill per 5 menit
FINDER_TIMEOUT      = 240     # batas atas subprocess finder (detik)


async def _auto_register_fresh_proxies(worker_id=None, email=None):
    """Semua proxy mati/diblok → jalankan proxy_finder.py & gabungkan hasilnya."""
    global PROXY_STATIC_LIST, _last_finder_run
    if TOR_ONLY:
        return False
    if time.time() - _last_finder_run < FINDER_MIN_INTERVAL:
        return False
    async with _finder_lock:
        if time.time() - _last_finder_run < FINDER_MIN_INTERVAL:
            return False
        _last_finder_run = time.time()
        script = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                              "proxy_finder.py")
        log(worker_id, email, "PROXY",
            "Semua proxy mati → jalankan proxy_finder.py (auto-refill)...")
        try:
            proc = await asyncio.create_subprocess_exec(
                sys.executable, script,
                "--target", "pandafaucet.com",
                "--per-source", "200", "--max", "60",
                "--concurrency", "60", "--timeout", "8",
                stdout=asyncio.subprocess.PIPE,
                stderr=asyncio.subprocess.STDOUT)
            out, _ = await asyncio.wait_for(proc.communicate(),
                                            timeout=FINDER_TIMEOUT)
            tail = out.decode("utf-8", "ignore").strip().splitlines()
            for line in tail[-3:]:
                log(worker_id, email, "PROXY", f"finder: {line}")
        except Exception as e:
            log(worker_id, email, "ERROR",
                f"proxy_finder gagal: {str(e)[:80]}")
            return False
        fresh = _load_proxy_file(PROXY_FILE, PROXY_FILE_MAX)
        if not fresh:
            log(worker_id, email, "PROXY", "auto-refill: tidak ada proxy hidup ditemukan")
            return False
        # utamakan proxy fresh (belum diblok) sebelum sisa list lama
        merged = [p for p in fresh if p not in _vpn_blocked]
        merged += [p for p in PROXY_STATIC_LIST if p not in merged]
        PROXY_STATIC_LIST = merged
        log(worker_id, email, "PROXY",
            f"auto-refill sukses: {len(merged)} proxy tersedia")
        return True


async def get_new_proxy(worker_id=None, email=None):
    global _proxy_index, _last_proxy, _global_proxy_fails

    if USE_SESSION_TEMPLATE and not SKIP_SESSION_PROXY:
        sid = _random_sid()
        proxy = PROXY_SESSION_TEMPLATE.format(sid=sid)
        return proxy, f"sess-{sid[-6:]}"

    while True:
        # refill proaktif: setelah N kegagalan proxy beruntun (global, lintas worker),
        # ganti modal proxy segar tanpa menunggu seluruh pool masuk blok
        if _global_proxy_fails >= AUTO_REFILL_FAIL_THRESHOLD:
            _global_proxy_fails = 0
            if await _auto_register_fresh_proxies(worker_id, email):
                continue
        need_refill = False
        async with _proxy_lock:
            now = time.time()
            for p in list(_vpn_blocked.keys()):
                if now >= _vpn_blocked[p]:
                    del _vpn_blocked[p]
            n = len(PROXY_STATIC_LIST)
            if n == 0:
                need_refill = True
                wait_sec = 15
            else:
                idx = _proxy_index
                pick = None
                # pass 1: prefer proxy unblocked DAN berbeda dari siklus sebelumnya
                for _ in range(n):
                    p = PROXY_STATIC_LIST[idx % n]
                    idx += 1
                    if p not in _vpn_blocked and p != _last_proxy:
                        pick = p
                        break
                # pass 2 (fallback): proxy unblocked apa pun — tetap beda index
                if pick is None:
                    for _ in range(n):
                        p = PROXY_STATIC_LIST[idx % n]
                        idx += 1
                        if p not in _vpn_blocked:
                            pick = p
                            break
                if pick is not None:
                    _proxy_index = idx
                    _last_proxy = pick
                    return pick, _proxy_label(pick)
                need_refill = True   # semua entri sedang diblok
                if _vpn_blocked:
                    wait_sec = max(1, int(min(_vpn_blocked.values()) - now))
                else:
                    wait_sec = 15

        if need_refill and await _auto_register_fresh_proxies(worker_id, email):
            continue   # ada proxy fresh → langsung coba lagi, tanpa menunggu
        if worker_id:
            log(worker_id, email, "WAIT", f"Semua static proxy blocked, tunggu {wait_sec}s")
        await asyncio.sleep(wait_sec + 1)


async def verify_proxy_target(worker_id, email, proxy_url):
    proxies = {"http": proxy_url, "https": proxy_url}
    session = AsyncSession(impersonate="chrome110", proxies=proxies,
                           timeout=PROXY_VERIFY_TIMEOUT, verify=False)
    try:
        try:
            r = await session.get(f"{BASE_URL}/")
        except Exception as e:
            return False, str(e)[:60]
        if r.status_code in (200, 301, 302):
            return True, f"HTTP {r.status_code}"
        return False, f"HTTP {r.status_code} (suspected block)"
    finally:
        await session.close()


# =====================================================================
# UTILS (identik)
# =====================================================================
def _extract(text, pattern, default=None):
    m = re.search(pattern, text)
    return m.group(1) if m else default


def needs_restart(resp):
    if not resp: return False
    for key in ("restart_claim", "fresh_claim_required"):
        if resp.get(key): return True
    fc = resp.get("flowCheck") or {}
    for key in ("restart_claim", "fresh_claim_required"):
        if fc.get(key): return True
    return False


def _quota_limited(resp):
    """pf_api mengirim globalQuota / ipQuota / emailQuota (dipaksa server,
    tidak bisa dibypass). Kembalikan info limit jika harian habis."""
    if not isinstance(resp, dict):
        return None
    def _num(v):
        try:
            return int(float(v or 0))
        except (TypeError, ValueError):
            return 0
    for key, scope in (("globalQuota", "global"),
                       ("ipQuota", "ip"),
                       ("emailQuota", "email")):
        q = resp.get(key)
        if isinstance(q, dict) and q.get("limited"):
            return {"scope": scope, "used": _num(q.get("used")),
                    "limit": _num(q.get("limit")), "retry": _num(q.get("retryAfter"))}
    return None


CF_CHALLENGE_MARKERS = (
    "just a moment", "cf-challenge", "attention required",
    "challenges.cloudflare.com",
)


def _validate_claim_page(r_text, sitekey, flow_id):
    if not r_text or not sitekey or not flow_id:
        return False, "missing sitekey/flow"
    head = r_text[:3000].lower()
    if any(m in head for m in CF_CHALLENGE_MARKERS):
        return False, "cloudflare challenge"
    if not sitekey.startswith("0x"):
        return False, f"sitekey format invalid ({sitekey[:10]}…)"
    return True, "ok"


# =====================================================================
# SOLVE_TURNSTILE — drop-in wrapper (perilaku identik, tapi 0ms overhead)
# =====================================================================
async def solve_turnstile(worker_id, email, pageurl, sitekey, action=None, cdata=None):
    if not sitekey:
        return None
    try:
        token = await SOLVER.request_token(
            domain=pageurl, sitekey=sitekey, action=action, cdata=cdata,
        )
        if token:
            log(worker_id, email, "SOLVER",
                f"Token OK (len={len(token)}) action={action}")
        return token
    except asyncio.TimeoutError:
        log(worker_id, email, "ERROR",
            f"Solver deadline {int(SOLVER_TASK_TIMEOUT_MS/1000)}s — abort")
        return None
    except Exception as e:
        msg = str(e)
        if "QUEUE_FULL" in msg:
            backoff = random.uniform(5, 10)
            log(worker_id, email, "WAIT",
                f"Solver QUEUE_FULL → backoff {backoff:.1f}s")
            await asyncio.sleep(backoff)
        else:
            log(worker_id, email, "ERROR", f"Solver: {msg[:80]}")
        return None


# =====================================================================
# API helper — request ke pandafaucet via session (proxy aktif)
# =====================================================================
async def api_post(session, coin, action, payload, referer):
    url = f"{BASE_URL}/pf_api?coin={coin}&action={action}"
    headers = {"Origin": BASE_URL, "Referer": referer, "Content-Type": "application/json"}
    try:
        r = await session.post(url, json=payload, headers=headers)
        return r.json()
    except Exception:
        return None


# =====================================================================
# ONE ATTEMPT — identik dengan pandax9.py lama
# =====================================================================
async def run_attempt(worker_id, email, attempt_num, coin):
    global _refilling_until, _uncertain_until, _global_proxy_fails
    coin_upper = coin.upper()

    if time.time() < _refilling_until:
        log(worker_id, email, "SKIP", f"refilling pause {int(_refilling_until - time.time())}s")
        return "skip"
    if time.time() < _uncertain_until:
        remain = int(_uncertain_until - time.time())
        log(worker_id, email, "SKIP", f"cooldown pasca-uncertain {remain}s")
        return "skip"

    proxy_url, proxy_label = await get_new_proxy(worker_id, email)
    if not proxy_url:
        log(worker_id, email, "FATAL", "Tidak ada proxy tersedia")
        return "skip"

    log(worker_id, email, "PROXY", f"Attempt {attempt_num} | {coin_upper} | sticky: {proxy_label}")

    ok, info = await verify_proxy_target(worker_id, email, proxy_url)
    if not ok:
        log(worker_id, email, "PROXY", f"Target tidak bisa diakses: {info} → rotasi")
        if not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY:
            block_proxy(proxy_url)
        return "retry_proxy"
    log(worker_id, email, "PROXYOK", f"Proxy sehat ({info})")

    proxies = {"http": proxy_url, "https": proxy_url}
    session = AsyncSession(impersonate="chrome110", proxies=proxies,
                           timeout=60.0, verify=False)
    t_cycle = time.time()

    try:
        try:
            await session.post(f"{BASE_URL}/auth_init",
                               json={"email": email, "password": DEFAULT_PASSWORD})
            lr = await session.post(f"{BASE_URL}/auth_login",
                                    json={"email": email, "password": DEFAULT_PASSWORD})
        except Exception as e:
            if _is_proxy_error(e):
                log(worker_id, email, "PROXY", f"Auth proxy error: {str(e)[:50]}")
                if not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY:
                    block_proxy(proxy_url)
                return "retry_proxy"
            log(worker_id, email, "ERROR", f"Auth error: {str(e)[:50]}")
            return "retry"

        try:
            login_status = lr.json().get("status")
        except Exception:
            login_status = None
            body_head = lr.text[:600].lower()
            if any(m in body_head for m in CF_CHALLENGE_MARKERS):
                log(worker_id, email, "PROXY",
                    f"Login diblok Cloudflare (HTTP {lr.status_code}) → rotasi")
                if not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY:
                    block_proxy(proxy_url)
                return "retry_proxy"
            if lr.headers.get("content-type", "").startswith("text/html"):
                log(worker_id, email, "PROXY",
                    f"Login HTML (HTTP {lr.status_code}) → dugaan proxy block")
                if not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY:
                    block_proxy(proxy_url)
                return "retry_proxy"
            log(worker_id, email, "PROXY",
                f"Login non-JSON (dugaan proxy/CF): {lr.text[:40]} → rotasi")
            if not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY:
                block_proxy(proxy_url)
            return "retry_proxy"

        if login_status != "success":
            log(worker_id, email, "ERROR", f"Gagal Login: {lr.text[:60]}")
            return "retry"

        claim_url = f"{BASE_URL}/claim-{coin}"

        r1 = await session.get(claim_url)
        flow1    = _extract(r1.text, r'const FLOW_ID="([0-9a-f]{64})"')
        sitekey1 = _extract(r1.text, r'data-sitekey="([^"]+)"')
        action1  = _extract(r1.text, r'data-action="([^"]+)"', "pf_claim_start")
        raw_cdata1 = _extract(r1.text, r'data-cdata="([^"]+)"', None)
        if raw_cdata1 is None:
            log(worker_id, email, "WAIT", "⚠️ data-cdata tidak ada → fallback flow1")
        cdata1 = raw_cdata1 or flow1
        wait1  = int(_extract(r1.text, r'const CFG_WAIT1\s*=\s*(\d+);', "7"))

        if not flow1 or not sitekey1:
            log(worker_id, email, "PROXY",
                "Parse claim page gagal (dugaan CF/proxy) → rotasi")
            if not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY:
                block_proxy(proxy_url)
            return "retry_proxy"

        ok_page, reason = _validate_claim_page(r1.text, sitekey1, flow1)
        if not ok_page:
            if reason == "cloudflare challenge":
                log(worker_id, email, "PROXY", f"Claim page invalid: {reason} → rotasi")
                if not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY:
                    block_proxy(proxy_url)
                return "retry_proxy"
            log(worker_id, email, "RETRY", f"Claim page invalid: {reason} → rotasi")
            return "retry"

        st = await api_post(session, coin, "status",
                            {"email": email, "flow_id": flow1,
                             "flow_check": "start", "flow_only": True},
                            claim_url)
        if st:
            ql = _quota_limited(st)
            if ql:
                if ql["scope"] == "global":
                    log(worker_id, email, "SKIP",
                        f"⛔ Kuota GLOBAL 24h habis ({ql['used']}/{ql['limit']}) → skip email")
                    return "skip"
                log(worker_id, email, "COIN",
                    f"⛔ Kuota {ql['scope']} {coin_upper} habis ({ql['used']}/{ql['limit']}) → coba coin lain")
                return "quota_switch"
            if st.get("blocked"):
                log(worker_id, email, "SKIP", f"blocked: {str(st.get('error',''))[:40]}")
                return "skip"
            if st.get("secondsLeft", 0) > 0:
                log(worker_id, email, "SKIP", f"cooldown {st['secondsLeft']}s")
                return "skip"
            if st.get("refilling"):
                log(worker_id, email, "COIN", f"{coin_upper} refilling → switch coin")
                return "switch_coin"
            if needs_restart(st):
                log(worker_id, email, "RETRY", "status: restart_claim")
                return "retry"
            fc = st.get("flowCheck") or {}
            if fc.get("ok"):
                log(worker_id, email, "STEP", f"flow_only OK ({fc.get('secondsLeft','?')}s left)")

        flow_deadline = time.time() + wait1

        ts1 = await solve_turnstile(worker_id, email, claim_url, sitekey1,
                                    action=action1, cdata=cdata1)
        if not ts1:
            return "retry"

        remaining = max(0.0, flow_deadline - time.time())
        if remaining > 0:
            await asyncio.sleep(remaining + 0.3)

        start_res = await api_post(session, coin, "start",
                                   {"email": email, "flow_id": flow1,
                                    "turnstile_token": ts1},
                                   claim_url)

        if not start_res:
            return "retry"
        ql = _quota_limited(start_res)
        if ql:
            if ql["scope"] == "global":
                log(worker_id, email, "SKIP",
                    f"⛔ Kuota GLOBAL 24h habis ({ql['used']}/{ql['limit']}) → skip email")
                return "skip"
            log(worker_id, email, "COIN",
                f"⛔ Kuota {ql['scope']} {coin_upper} habis ({ql['used']}/{ql['limit']}) → coba coin lain")
            return "quota_switch"
        if start_res.get("blocked"):
            log(worker_id, email, "SKIP", f"start blocked: {str(start_res.get('error',''))[:40]}")
            return "skip"
        if start_res.get("refilling"):
            log(worker_id, email, "COIN", f"Start: {coin_upper} refilling → switch coin")
            return "switch_coin"
        if needs_restart(start_res):
            log(worker_id, email, "RETRY", "start: restart_claim")
            return "retry"
        if not start_res.get("ok"):
            log(worker_id, email, "RETRY", f"Start ditolak: {str(start_res)[:80]}")
            return "retry"

        claim_token = start_res.get("token")
        wait2 = start_res.get("waitSeconds", 20)
        t_start_ok = time.time()
        log(worker_id, email, "STEP", f"Start OK! Tunggu {wait2}s...")

        final_url = f"{BASE_URL}/final-claim-{coin}?flow={flow1}"
        fr = await session.get(final_url)
        final_flow    = _extract(fr.text, r'const FLOW_ID="([0-9a-f]{64})"', flow1)
        final_sitekey = _extract(fr.text, r'data-sitekey="([^"]+)"', sitekey1)
        final_action  = _extract(fr.text, r"action:'(pf_claim_[a-z]+)'", "pf_claim_payout")
        raw_final_cdata = _extract(fr.text, r'data-flow="([^"]+)"', None)
        if raw_final_cdata is None:
            log(worker_id, email, "WAIT", "⚠️ data-flow tidak ada → fallback flow1")
        final_cdata = raw_final_cdata or flow1

        ok_page, reason = _validate_claim_page(fr.text, final_sitekey, final_flow)
        if not ok_page:
            if reason == "cloudflare challenge":
                log(worker_id, email, "PROXY", f"Final page invalid: {reason} → rotasi")
                if not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY:
                    block_proxy(proxy_url)
                return "retry_proxy"
            log(worker_id, email, "RETRY", f"Final page invalid: {reason} → rotasi")
            return "retry"

        pre = await api_post(session, coin, "status",
                             {"email": email, "flow_id": final_flow,
                              "flow_check": "claim", "flow_only": True},
                             final_url)
        if pre:
            ql = _quota_limited(pre)
            if ql:
                if ql["scope"] == "global":
                    log(worker_id, email, "SKIP",
                        f"⛔ Kuota GLOBAL 24h habis ({ql['used']}/{ql['limit']}) → skip email")
                    return "skip"
                log(worker_id, email, "COIN",
                    f"⛔ Kuota {ql['scope']} {coin_upper} habis ({ql['used']}/{ql['limit']}) → coba coin lain")
                return "quota_switch"
            if pre.get("blocked"):
                log(worker_id, email, "SKIP", f"preflight blocked: {str(pre.get('error',''))[:40]}")
                return "skip"
            if pre.get("refilling"):
                log(worker_id, email, "COIN", f"Preflight: {coin_upper} refilling → switch coin")
                return "switch_coin"
            if needs_restart(pre):
                log(worker_id, email, "RETRY", "preflight: restart_claim")
                return "retry"
            fc = pre.get("flowCheck") or {}
            if not fc.get("ok"):
                log(worker_id, email, "RETRY", "preflight: flowCheck not ok")
                return "retry"

        # Solver #2 — paralel dengan sleep(wait2)
        solve_task = asyncio.create_task(solve_turnstile(
            worker_id, email, final_url, final_sitekey,
            action=final_action, cdata=final_cdata
        ))
        await asyncio.sleep(wait2)
        ts2 = await solve_task
        if not ts2:
            return "retry"

        elapsed = time.time() - t_start_ok
        solver_extra = max(0.0, elapsed - wait2)
        log(worker_id, email, "TIMING",
            f"Elapsed since start: {elapsed:.1f}s "
            f"(wait2={wait2}s, solver_extra={solver_extra:.1f}s)")

        claim_payload = {"token": claim_token, "email": email,
                         "turnstile_token": ts2, "flow_id": final_flow}
        cr = await api_post(session, coin, "claim", claim_payload, final_url)

        if cr:
            ql = _quota_limited(cr)
            if ql:
                if ql["scope"] == "global":
                    log(worker_id, email, "SKIP",
                        f"⛔ Kuota GLOBAL 24h habis ({ql['used']}/{ql['limit']}) → skip email")
                    return "skip"
                log(worker_id, email, "COIN",
                    f"⛔ Kuota {ql['scope']} {coin_upper} habis ({ql['used']}/{ql['limit']}) → coba coin lain")
                return "quota_switch"
            if cr.get("ad_rule_hold") is True:
                log(worker_id, email, "SKIP",
                    "ad_rule_hold: iklan wajib — skip (bukan error proxy)")
                return "skip"
            err_msg = str(cr.get("error", "") or "").lower()
            if "uncertain" in err_msg:
                _uncertain_until = time.time() + UNCERTAIN_PAUSE_SEC
                log(worker_id, email, "SKIP",
                    f"FaucetPay uncertain → SKIP, cooldown global {UNCERTAIN_PAUSE_SEC}s")
                return "skip"

        if cr and cr.get("cooldown"):
            log(worker_id, email, "SKIP",
                f"FaucetPay cooldown {cr.get('secondsLeft', '?')}s — lanjut email lain")
            return "skip"
        if cr and cr.get("ok"):
            log(worker_id, email, "SUCCESS",
                f"✅ BERHASIL! {cr.get('amountCoin')} {coin_upper} "
                f"(total {time.time()-t_cycle:.0f}s)")
            return "success"
        if cr and cr.get("refilling"):
            log(worker_id, email, "COIN", f"Claim: {coin_upper} refilling → switch coin")
            return "switch_coin"
        if cr and cr.get("blocked"):
            log(worker_id, email, "SKIP", f"claim blocked: {str(cr.get('error',''))[:40]}")
            return "skip"
        if needs_restart(cr):
            log(worker_id, email, "RETRY", f"claim restart_claim ({elapsed:.1f}s)")
            return "retry"
        if cr is None:
            log(worker_id, email, "PROXY",
                "Claim response bukan JSON (dugaan proxy/CF block)")
            if not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY:
                block_proxy(proxy_url)
            return "retry_proxy"

        log(worker_id, email, "RETRY", f"Claim Gagal: {str(cr)[:80]}")
        return "retry"

    except Exception as e:
        if _is_proxy_error(e):
            log(worker_id, email, "PROXY", f"Proxy error: {str(e)[:50]}")
            if not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY:
                block_proxy(proxy_url)
            return "retry_proxy"
        log(worker_id, email, "ERROR", f"Crash: {str(e)[:50]}")
        return "retry"
    finally:
        await session.close()


# =====================================================================
# REFILL BLACKLIST (global, TTL)
# =====================================================================
def _coin_refilling_active(coin):
    exp = _refilled_coins.get(coin)
    if exp is None:
        return False
    if time.time() >= exp:
        _refilled_coins.pop(coin, None)
        return False
    return True


def _next_active_coin_index(start):
    """Index coin berikutnya yang TIDAK refilling; None jika semua refilling."""
    n = len(SORTED_COINS)
    for k in range(n):
        idx = (start + k) % n
        if not _coin_refilling_active(SORTED_COINS[idx]):
            return idx
    return None


# =====================================================================
# ACCOUNT PROCESS
# =====================================================================
async def process_single_account(worker_id, email):
    global _refilling_until
    if not SORTED_COINS:
        SORTED_COINS.extend(AVAILABLE_COINS)

    attempt = 1
    coin_index = 0
    proxy_fails = 0
    quota_switches = 0

    while attempt <= MAX_ATTEMPTS_PER_ACCOUNT:
        if time.time() < _refilling_until:
            log(worker_id, email, "SKIP", "refilling pause (skip account)")
            return False
        if time.time() < _uncertain_until:
            remain = int(_uncertain_until - time.time())
            log(worker_id, email, "SKIP", f"cooldown pasca-uncertain {remain}s (skip account)")
            return False

        active_idx = _next_active_coin_index(coin_index)
        if active_idx is None:
            log(worker_id, email, "COIN",
                f"Semua coin refilling! Pause global {REFILLING_PAUSE_SEC}s...")
            _refilling_until = time.time() + REFILLING_PAUSE_SEC
            return False
        if active_idx != coin_index:
            coin_index = active_idx
        current_coin = SORTED_COINS[coin_index]
        result = await run_attempt(worker_id, email, attempt, current_coin)

        if result == "success":
            return True
        if result == "skip":
            return False

        if result == "retry_proxy":
            proxy_fails += 1
            if proxy_fails >= MAX_PROXY_FAILS_PER_ACCOUNT:
                log(worker_id, email, "ERROR",
                    f"{proxy_fails}x proxy gagal beruntun — skip email ini")
                return False
            log(worker_id, email, "PROXY",
                f"Retry proxy #{proxy_fails}/{MAX_PROXY_FAILS_PER_ACCOUNT} "
                f"(kuota attempt utuh)")
            await asyncio.sleep(1)
            continue

        proxy_fails = 0

        if result == "quota_switch":
            quota_switches += 1
            if quota_switches > len(SORTED_COINS):
                log(worker_id, email, "ERROR",
                    "Semua coin terkena limit kuota — skip email ini")
                return False
            next_idx = _next_active_coin_index((coin_index + 1) % len(SORTED_COINS))
            if next_idx is None:
                log(worker_id, email, "COIN",
                    f"Semua coin refilling! Pause global {REFILLING_PAUSE_SEC}s...")
                _refilling_until = time.time() + REFILLING_PAUSE_SEC
                return False
            coin_index = next_idx
            log(worker_id, email, "RETRY",
                f"Ganti ke coin {SORTED_COINS[coin_index].upper()} "
                f"(kuota limit #{quota_switches}, attempt tidak berkurang)")
            await asyncio.sleep(1)
            continue

        if result == "switch_coin":
            _refilled_coins[current_coin] = time.time() + REFILLING_PAUSE_SEC
            log(worker_id, email, "COIN",
                f"{current_coin.upper()} diblacklist refill global "
                f"({REFILLING_PAUSE_SEC}s) — berlaku untuk semua worker/email")
            next_idx = _next_active_coin_index((coin_index + 1) % len(SORTED_COINS))
            if next_idx is None:
                log(worker_id, email, "COIN",
                    f"Semua coin refilling! Pause global {REFILLING_PAUSE_SEC}s...")
                _refilling_until = time.time() + REFILLING_PAUSE_SEC
                return False

            coin_index = next_idx
            log(worker_id, email, "RETRY",
                f"Ganti ke coin {SORTED_COINS[coin_index].upper()} (attempt tidak berkurang)")
            await asyncio.sleep(1)
            continue

        if attempt < MAX_ATTEMPTS_PER_ACCOUNT:
            log(worker_id, email, "RETRY",
                f"Retry {attempt+1}/{MAX_ATTEMPTS_PER_ACCOUNT} — sticky sid baru + siklus baru")
            await asyncio.sleep(2)
        else:
            log(worker_id, email, "ERROR",
                f"Habis {MAX_ATTEMPTS_PER_ACCOUNT} attempt, skip email ini")
        attempt += 1
    return False


# =====================================================================
# WORKER
# =====================================================================
async def worker(worker_id, email_list):
    total = len(email_list)
    if total == 0:
        log(worker_id, None, "SKIP", "chunk kosong (email < worker count)")
        return

    log(worker_id, None, "BOT", f"Chunk assigned: {total} email")

    for idx, email in enumerate(email_list):
        if time.time() < _refilling_until:
            remaining = total - idx
            log(worker_id, email, "SKIP",
                f"refilling pause {int(_refilling_until - time.time())}s — "
                f"berhenti, {remaining} email sisa di chunk")
            return
        if time.time() < _uncertain_until:
            remaining = total - idx
            log(worker_id, email, "SKIP",
                f"cooldown pasca-uncertain {int(_uncertain_until - time.time())}s — "
                f"berhenti, {remaining} email sisa di chunk")
            return

        await process_single_account(worker_id, email)

        if idx < total - 1:
            await asyncio.sleep(DELAY_BETWEEN_ACCOUNTS)

    log(worker_id, None, "BOT", f"Chunk selesai ({total} email diproses)")


# =====================================================================
# MAIN
# =====================================================================
async def main():
    print()
    print(f"{Fore.CYAN}{Style.BRIGHT}{'═' * 58}{Style.RESET_ALL}")
    print(f"{Fore.CYAN}{Style.BRIGHT}  ✦  PANDAFAUCET MULTI-COIN — MERGED SOLVER{Style.RESET_ALL}")
    print(f"{Fore.CYAN}{Style.BRIGHT}{'═' * 58}{Style.RESET_ALL}")
    log(None, None, "BOT", f"Coins          : dinamis, sort USD ({', '.join(c.upper() for c in AVAILABLE_COINS)})")
    if _file_proxies:
        log(None, None, "BOT", f"Proxy file     : {len(_file_proxies)} dimuat dari {PROXY_FILE} (fallback)")
    if SKIP_SESSION_PROXY:
        log(None, None, "BOT", "Proxy awal     : DILEWATI (skip session template) — memakai static/found list")
    else:
        log(None, None, "BOT", f"Proxy mode     : {'sticky session' if USE_SESSION_TEMPLATE else 'static list'}")
    log(None, None, "BOT", f"Solver         : in-process Node child (puppeteer-real-browser)")
    log(None, None, "BOT", f"  ↳ transport  : stdin/stdout NDJSON (no HTTP, no polling)")
    log(None, None, "BOT", f"  ↳ MAX_ACTIVE : {SOLVER_MAX_ACTIVE}")
    log(None, None, "BOT", f"  ↳ MAX_QUEUE  : {SOLVER_MAX_QUEUE}")
    log(None, None, "BOT", f"  ↳ TASK_TMO   : {SOLVER_TASK_TIMEOUT_MS}ms")
    log(None, None, "BOT", f"Max attempts   : {MAX_ATTEMPTS_PER_ACCOUNT}/email")
    log(None, None, "BOT", f"Workers        : {MAX_WORKERS} (email round-robin chunks)")

    if (not USE_SESSION_TEMPLATE or SKIP_SESSION_PROXY) and not PROXY_STATIC_LIST:
        log(None, None, "FATAL", "PROXY_STATIC_LIST kosong & proxy awal di-skip — jalankan proxy_finder.py dulu!")
        return

    await fetch_and_sort_coins()
    await SOLVER.start()

    try:
        while True:
            if not os.path.exists(FILE_EMAILS):
                log(None, None, "FATAL", f"File email tidak ditemukan: {FILE_EMAILS}")
                return
            with open(FILE_EMAILS, "r") as f:
                emails = [l.strip() for l in f if l.strip()]
            random.shuffle(emails)

            n_emails = len(emails)
            chunks = [[] for _ in range(MAX_WORKERS)]
            for i, e in enumerate(emails):
                chunks[i % MAX_WORKERS].append(e)

            chunk_info = ", ".join(f"W{i+1}={len(c)}" for i, c in enumerate(chunks))
            log(None, None, "BOT", f"Batch emails  : {n_emails} → split {chunk_info}")

            tasks = []
            for i in range(1, MAX_WORKERS + 1):
                tasks.append(asyncio.create_task(worker(i, chunks[i - 1])))
                await asyncio.sleep(2)
            await asyncio.gather(*tasks)
            # Semua email batch ini selesai → cek ulang status refill dari awal
            if _refilled_coins:
                rechecked = ", ".join(c.upper() for c in list(_refilled_coins))
                log(None, None, "COIN",
                    f"Semua email batch selesai — reset blacklist refill "
                    f"({rechecked}); coin dicek ulang dari batch berikutnya")
                _refilled_coins.clear()
            await fetch_and_sort_coins()   # refresh harga & urutan coin tiap batch
            await asyncio.sleep(10)
    finally:
        await SOLVER.stop()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print(Fore.RED + "\n[-] Dihentikan paksa oleh user.")
